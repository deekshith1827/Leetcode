o(logn) approach
class Solution {
    public int maximumProduct(int[] nums) {

        // Sort the array
        Arrays.sort(nums);

        int n = nums.length;

        // Product of the three largest numbers
        int product1 = nums[n - 1] * nums[n - 2] * nums[n - 3];

        // Product of the largest number and two smallest numbers
        int product2 = nums[n - 1] * nums[0] * nums[1];

        // Return the maximum product
        return Math.max(product1, product2);
    }
}

o(n) approach
class Solution {
    public int maximumProduct(int[] nums) {

        // Track the three largest numbers
        int max1 = Integer.MIN_VALUE;
        int max2 = Integer.MIN_VALUE;
        int max3 = Integer.MIN_VALUE;

        // Track the two smallest numbers
        int min1 = Integer.MAX_VALUE;
        int min2 = Integer.MAX_VALUE;

        // Traverse the array only once
        for (int num : nums) {

            // Update the three largest numbers
            if (num >= max1) {
                max3 = max2;
                max2 = max1;
                max1 = num;
            }
            else if (num >= max2) {
                max3 = max2;
                max2 = num;
            }
            else if (num > max3) {
                max3 = num;
            }

            // Update the two smallest numbers
            if (num <= min1) {
                min2 = min1;
                min1 = num;
            }
            else if (num < min2) {
                min2 = num;
            }
        }

        // Case 1: Product of the three largest numbers
        // Case 2: Product of the largest number and two smallest (negative) numbers
        // Return the maximum of both cases
        return Math.max(max1 * max2 * max3,
                        max1 * min1 * min2);
    }
}
