class Solution {
    public int trap(int[] height) {

        // Total number of bars
        int n = height.length;

        // Array to store the tallest bar from the left up to each index
        int[] leftMax = new int[n];
        leftMax[0] = height[0];

        // Build the leftMax array
        for (int i = 1; i < n; i++) {
            leftMax[i] = Math.max(height[i], leftMax[i - 1]);
        }

        // Array to store the tallest bar from the right up to each index
        int[] rightMax = new int[n];
        rightMax[n - 1] = height[n - 1];

        // Build the rightMax array
        for (int i = n - 2; i >= 0; i--) {
            rightMax[i] = Math.max(height[i], rightMax[i + 1]);
        }

        int trappedWater = 0;

        // Calculate trapped water at every index
        for (int i = 0; i < n; i++) {

            // Water level is limited by the shorter of the two maximum walls
            int waterLevel = Math.min(leftMax[i], rightMax[i]);

            // Water stored at current index
            trappedWater += waterLevel - height[i];
        }

        return trappedWater;
    }
}

