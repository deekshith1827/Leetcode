class Solution {
    public int maxProduct(int n) {

        // Stores the largest digit
        int first = 0;

        // Stores the second largest digit
        int second = 0;

        // Process each digit of the number
        while (n > 0) {

            // Extract the last digit
            int digit = n % 10;

            // If current digit is the largest so far
            if (digit > first) {
                second = first;
                first = digit;
            }

            // Otherwise, update the second largest digit
            else if (digit > second) {
                second = digit;
            }

            // Remove the last digit
            n /= 10;
        }

        // Maximum product
        return first * second;
    }
}

